# ==============================================================================
# Redshift Connector Service - Environment Variables
# Location: redshift-connector/.env
# ==============================================================================

SERVICE_NAME=redshift-connector
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8007

# Database Connection (ces-internal-net)
DATABASE_URL=postgresql+asyncpg://ces_user:ces_secret_2024@postgresql:5432/ces_db
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars

# Redshift Cluster Credentials
REDSHIFT_HOST=localhost
REDSHIFT_PORT=5439
REDSHIFT_DB=acme_dw
REDSHIFT_USER=ces_svc
REDSHIFT_PASSWORD=
