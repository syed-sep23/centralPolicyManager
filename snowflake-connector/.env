# ==============================================================================
# Snowflake Connector Service - Environment Variables
# Location: snowflake-connector/.env
# ==============================================================================

SERVICE_NAME=snowflake-connector
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8006

# Database Connection (ces-internal-net)
DATABASE_URL=postgresql+asyncpg://ces_user:ces_secret_2024@postgresql:5432/ces_db
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars

# Note: Platform credentials are not stored here.
# Credentials are dynamically queried from the metadata_platforms database table.
