# ==============================================================================
# Core Backend Service (FastAPI) - Environment Variables
# Location: backend-service/.env
# Exclusively connected to ces-postgres (Internal Bridge Network)
# ==============================================================================

SERVICE_NAME=backend-service
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# PostgreSQL System Catalog Connection
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=ces_user
POSTGRES_PASSWORD=ces_secret_2024
POSTGRES_DB=ces_db

# Security & Authentication Tokens
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Coordination Services
OPA_URL=http://opa:8181
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=policy-deployment

# Gateway Root Path
ROOT_PATH=
