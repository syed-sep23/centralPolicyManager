# ==============================================================================
# Core Backend Service (FastAPI) - Environment Variables
# Location: backend-service/.env
# Exclusively connected to ces-postgres (Internal Bridge Network)
# ==============================================================================

SERVICE_NAME=backend-service
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# PostgreSQL System Catalog Connection
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_USER=ces_user
POSTGRES_PASSWORD=ces_secret_2024
POSTGRES_DB=ces_db

# Security & Authentication Tokens
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Coordination Services
OPA_URL=http://opa:8181
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
SNOWFLAKE_CONNECTOR_URL=http://snowflake-connector:8006
REDSHIFT_CONNECTOR_URL=http://redshift-connector:8007


# Gateway Root Path
ROOT_PATH=

# ==============================================================================
# Celery Beat Scheduled Metadata Synchronization
# ==============================================================================
# Option A: Standard 5-part cron syntax (minute hour day-of-month month day-of-week)
# Examples:
#   "0 * * * *"    -> Hourly at minute 0 (Default)
#   "*/30 * * * *" -> Every 30 minutes
#   "0 */2 * * *"  -> Every 2 hours
#   "0 0 * * *"    -> Once daily at midnight UTC
SYNC_METADATA_CRON=0 * * * *

# Option B: Interval in hours or minutes (used if SYNC_METADATA_CRON is commented out or empty)
SYNC_METADATA_INTERVAL_HOURS=1
# SYNC_METADATA_INTERVAL_MINUTES=30

