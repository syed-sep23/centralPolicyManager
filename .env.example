# ==============================================================================
# Central Entitlement Service (CES) - Environment Variables Example
# ==============================================================================
PG_PASSWORD=ces_secret_2024
DATABASE_URL=postgresql+asyncpg://ces_user:ces_secret_2024@postgresql:5432/ces_db
SECRET_KEY=dev-secret-key-change-in-production-at-least-32-chars
LOG_LEVEL=INFO
ENVIRONMENT=development
OPA_URL=http://opa:8181
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0
SNOWFLAKE_CONNECTOR_URL=http://snowflake-connector:8006
REDSHIFT_CONNECTOR_URL=http://redshift-connector:8007
GATEWAY_PORT=80

# Celery Beat Metadata Sync Schedule
# Option A: 5-part cron syntax (e.g., "0 * * * *" hourly, "*/30 * * * *" every 30m, "0 */2 * * *" every 2h)
SYNC_METADATA_CRON=0 * * * *
# Option B: Numeric interval in hours or minutes (used if SYNC_METADATA_CRON is commented out or empty)
SYNC_METADATA_INTERVAL_HOURS=1
# SYNC_METADATA_INTERVAL_MINUTES=30

